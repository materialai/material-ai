# ============================================================
# 新材料工艺偏差排查AI系统 - 环境配置
# 复制此文件为 .env 后填入实际值
# ============================================================

# ---------- 豆包企业API ----------
DOUBAO_API_KEY=your_doubao_enterprise_api_key_here
DOUBAO_CHAT_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_EMBED_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/embeddings
DOUBAO_MODEL_ID=ep-xxxxxxxxxxxxxxxxxxxxxxxx  # 你的模型接入点ID

# ---------- PostgreSQL ----------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASS=your_password
PG_DB=material_db

# ---------- 业务参数 ----------
# 偏差触发阈值：实际值偏离理论预期超过该百分比时自动启动排查
DEVIATION_THRESHOLD_PERCENT=15

# 单次头脑风暴最多输出假设数量
MAX_HYPOTHESIS_COUNT=5

# 单次追问最多问题数
MAX_QUESTIONS_PER_ROUND=3

# 最大追问轮次（超过自动熔断转专家）
MAX_QUESTION_ROUNDS=3

# 经验规则置信度参数
# 命中时增加量
CONFIDENCE_HIT_DELTA=0.05
# 未命中时减少量
CONFIDENCE_MISS_DELTA=0.1
# 置信度上下限
CONFIDENCE_MIN=0.0
CONFIDENCE_MAX=1.0
# 初始置信度（新规则入库时）
CONFIDENCE_INIT=0.5

# RAG向量检索召回数量
RAG_TOP_K=4

# ---------- 改善效果回授 ----------
# 改善方案执行后第N天推送回授提醒
IMPROVE_FEEDBACK_DAYS=7,14

# ---------- 豆包API限流 ----------
# 每秒最大请求数
DOUBAO_RPS_LIMIT=5
# 单次请求超时秒数
DOUBAO_TIMEOUT=60

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
